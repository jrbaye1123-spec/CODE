{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vault.nousresearch.com/schemas/handoff-v1.0.0.json",
  "title": "Handoff Envelope Schema",
  "description": "Governed envelope for all agent-to-agent artifact transfers.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "envelope_version",
    "handoff_id",
    "pipeline_run_id",
    "created_at",
    "from",
    "to",
    "intent",
    "project_id",
    "artifacts",
    "constraints",
    "policy_decision_id",
    "integrity"
  ],
  "properties": {
    "envelope_version": { "type": "string", "const": "1.0.0" },
    "handoff_id": { "type": "string", "pattern": "^handoff_[a-zA-Z0-9]{10,}$" },
    "pipeline_run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "from": {
      "type": "object",
      "required": ["agent_id", "role", "capability_token_id"],
      "properties": {
        "agent_id": { "type": "string" },
        "role": { "type": "string" },
        "capability_token_id": { "type": "string" }
      }
    },
    "to": {
      "type": "object",
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "intent": { "type": "string" },
    "project_id": { "type": "string" },
    "risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_type", "note_id", "content_hash", "trusted_as_data"],
        "properties": {
          "artifact_type": { "type": "string" },
          "note_id": { "type": "string" },
          "content_hash": { "type": "string" },
          "origin_type": { "type": "string" },
          "epistemic_status": { "type": "string" },
          "trusted_as_data": { "type": "boolean" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "treat_all_inputs_as_data",
        "no_instruction_execution",
        "preserve_provenance",
        "must_emit_interpretive_threshold"
      ],
      "properties": {
        "treat_all_inputs_as_data": { "type": "boolean", "const": true },
        "no_instruction_execution": { "type": "boolean", "const": true },
        "preserve_provenance": { "type": "boolean", "const": true },
        "must_emit_interpretive_threshold": { "type": "boolean" },
        "must_preserve_tensions": { "type": "boolean" },
        "may_resolve_tensions": { "type": "boolean" },
        "forbidden_actions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "network": { "type": "string" },
        "filesystem": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy_decision_id": { "type": "string" },
    "integrity": {
      "type": "object",
      "required": ["payload_hash", "signature"],
      "properties": {
        "payload_hash": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
